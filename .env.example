# 复制为 .env。不要将 .env 提交到 Git。
# 本地直接运行默认使用 SQLite + Hash Embedding + Mock LLM，不需要启动 MySQL/Redis。
DEMO_MODE=true
DATABASE_URL=
REDIS_URL=
REDIS_CACHE_TTL=300

# Docker Compose 使用 MySQL + Redis。请修改下面的密码，再执行 docker compose。
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_DATABASE=enterprise_rag
MYSQL_USER=rag_user
MYSQL_PASSWORD=change-this-app-password

# DeepSeek（真实模型模式需要填写）
# DEMO_MODE=false
# DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
APP_API_TOKEN=replace-with-a-long-random-token

# 数据和模型存储
APP_DATA_DIR=./.local_data
MODEL_CACHE_DIR=./.local_data/models

# 文档切分与检索
CHUNK_SIZE=450
CHUNK_OVERLAP=60
MAX_UPLOAD_MB=8
TOP_K=5
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-base
MAX_AGENT_STEPS=12

# 本地测试可覆盖为 EMBEDDING_BACKEND=hash / VECTOR_BACKEND=sqlite / LLM_BACKEND=mock。
# Docker Compose 会将 DB_HOST、DB_PORT、DB_USER、DB_PASSWORD、DB_NAME 和 REDIS_URL 注入 API 容器。
