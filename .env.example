# Copy to .env locally. NEVER commit .env.
# Quick offline demo (does not test LLM or Agent). Set false for real integration.
DEMO_MODE=true
# For full functionality set all 3 below:
# DEMO_MODE=false
# DEEPSEEK_API_KEY=your_key_here
# APP_API_TOKEN=replace-with-long-random-secret
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
APP_DATA_DIR=./.local_data
MODEL_CACHE_DIR=./.local_data/models
CHUNK_SIZE=450
CHUNK_OVERLAP=60
MAX_UPLOAD_MB=8
TOP_K=5
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-base
MAX_AGENT_STEPS=12
# For testing overrides: EMBEDDING_BACKEND=hash, VECTOR_BACKEND=sqlite, LLM_BACKEND=mock
# Production-oriented local demo defaults when DEMO_MODE=false:
# EMBEDDING_BACKEND=bge / VECTOR_BACKEND=chroma / LLM_BACKEND=deepseek
