FROM python:3.11-slim
WORKDIR /workspace
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
# torch/sentence-transformers build is large; set MODEL_CACHE_DIR to a mounted volume.
COPY requirements-v2.txt .
RUN pip install --no-cache-dir -r requirements-v2.txt
COPY . .
EXPOSE 8000
CMD ["uvicorn","enterprise.api:app","--host","0.0.0.0","--port","8000"]
